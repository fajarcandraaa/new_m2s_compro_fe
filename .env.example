# Internal origin of the Go backend. Needed at BUILD time (rewrites for /api and /uploads are
# resolved during `next build`) and at RUNTIME (Server Components fetch it directly).
BACKEND_URL=http://localhost:8080

# Shared secret the backend sends as X-Revalidate-Secret to POST /api/revalidate.
# Must match the backend's REVALIDATE_SECRET.
REVALIDATE_SECRET=change-me

# Public origin of this site (canonical URLs, sitemap, Open Graph). Inlined at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional runtime override for server code (sitemap, canonical URLs, JSON-LD). Defaults to NEXT_PUBLIC_SITE_URL.
# SITE_URL=https://mindtoscreen.com
